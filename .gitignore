# Local data and runtime artifacts
#   Versioned evaluation contracts live under evals/. Everything below requires
#   source, privacy, and license review before selected summaries move there.
data/
artifacts/
reports/
logs/
cache/

# Legacy and accidental machine-generated evaluation reports
/evals/snapshots/

# MLflow runtime state
#   Sourced from mlflow/mlflow's upstream .gitignore. The broad outputs/ rule and
#   MLflow source-tree protobuf rule are intentionally not applicable here.
mlruns/
mlartifacts/
mlruns*.db
mlflow.db
*-shm
*-wal
**/basic_auth.db

# Generic templates sometimes ignore config/ wholesale. Keep that rule disabled:
# public configuration schemas and examples may belong in version control.
# config/

# Operating systems
.DS_Store
