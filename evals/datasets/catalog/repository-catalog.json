  "decision_definitions": {
    "active_discovery": "进入当前真实 Issue 候选发现池，要求任务互补且有足够关闭 Issue。",
    "heldout_evaluation": "保留作跨实现或跨平台验证，避免与训练池中的近重复任务混用。",
    "watch": "生态价值明确，但关闭 Issue 太少、任务重复或外部依赖过强，暂不进入发现池。",
    "reference_only": "用于责任路由、依赖边界或产品对照，不作为当前 Case 来源。",
    "excluded": "已归档、面向旧版生态，或仅因兼容表出现而未获得数据源资格。"
  },
