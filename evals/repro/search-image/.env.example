ENVIRONMENT=prod
LOG_LEVEL=INFO
COMMAND_START=["/"]
COMMAND_SEP=[" "]

# Must be nonempty to load the plugin; default searches need a valid SauceNAO key.
# For explicit /搜图 --a2d tests only, a labeled placeholder is sufficient.
SAUCENAO_API_KEY=

# Use a dedicated OneBot V11 test connection with the same token on both ends.
# Reverse WebSocket endpoint: ws://127.0.0.1:18080/onebot/v11/ws
ONEBOT_ACCESS_TOKEN=

# Optional HTTP proxy, if needed by the selected search service.
# PROXY=http://127.0.0.1:7890
